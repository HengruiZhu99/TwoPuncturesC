@@ -759,8 +762,71 @@ void polynomial_basis(int N,double x,std::vector<double>&value,std::vector<doubl
  for(int i=2;i<N;i++){value[i]=2*x*value[i-1]-value[i-2];first[i]=2*value[i-1]+2*x*first[i-1]-first[i-2];}
  value[0]=.5;
 }
+#if HISPID_BARYCENTRIC_SAMPLER
+// Tensor interpolation of the original nodal polynomial. Difference sums
+// preserve constants and avoid converting large auxiliary values to a noisy
+// coefficient tail. Extended accumulators are useful on x86 host samplers.
+struct SamplingWeights {
+ std::vector<long double>value,derivative;
+ int nearest=0;
+ SamplingWeights(int n,long double x):value(n),derivative(n){
+  const long double pi=std::acos(-1.L);
+  std::vector<long double>node(n),weight(n),term(n);
+  long double distance=INFINITY;
+  for(int j=0;j<n;j++){
+   const long double theta=pi*(j+.5L)/n;node[j]=-std::cos(theta);
+   weight[j]=(j%2?-1.L:1.L)*std::sin(theta);
+   if(std::abs(x-node[j])<distance){distance=std::abs(x-node[j]);nearest=j;}
+  }
+  if(distance<8*std::numeric_limits<long double>::epsilon()){
+   value[nearest]=1;
+   for(int j=0;j<n;j++)if(j!=nearest){
+    derivative[j]=weight[j]/(weight[nearest]*(node[nearest]-node[j]));
+    derivative[nearest]-=derivative[j];
+   }return;
+  }
+  long double sum=0,square=0;
+  for(int j=0;j<n;j++){term[j]=weight[j]/(x-node[j]);sum+=term[j];square+=term[j]/(x-node[j]);}
+  for(int j=0;j<n;j++){
+   value[j]=term[j]/sum;
+   // The nearest derivative is unused by the constant-preserving sum, so
+   // its potentially cancelling expression cannot contaminate a sample.
+   if(j!=nearest)derivative[j]=value[j]*(square/sum-1/(x-node[j]));
+  }
+ }
+};
+void evaluate_nodal_mode(const HiSpID_Data&s,int k,double t,double eta,double P[4][3]){
+ const int na=s.local.n[0],nb=s.local.n[1];
+ const long double lambda=hispid::AxisDerivatives::radial_stretch,den=lambda+(1-lambda)*t;
+ const long double kap=hispid::AxisDerivatives::angular_stretch,T=std::tanh(kap);
+ SamplingWeights a(na,2*t/den-1),b(nb,std::atanh(eta*T)/kap);
+ std::vector<long double>row(size_t(nb)*8);
+ for(int j=0;j<nb;j++)for(int v=0;v<4;v++){
+  const double center=s.values[4*(a.nearest+na*(j+nb*k))+v];
+  long double value=center,d=0;
+  for(int i=0;i<na;i++)if(i!=a.nearest){
+   const long double difference=(long double)s.values[4*(i+na*(j+nb*k))+v]-center;
+   value+=a.value[i]*difference;d+=a.derivative[i]*difference;
+  }row[8*j+v]=value;row[8*j+4+v]=d;
+ }
+ for(int v=0;v<4;v++){
+  const long double center=row[8*b.nearest+v],dc=row[8*b.nearest+4+v];
+  long double value=center,dt=dc,de=0;
+  for(int j=0;j<nb;j++)if(j!=b.nearest){
+   value+=b.value[j]*(row[8*j+v]-center);
+   dt+=b.value[j]*(row[8*j+4+v]-dc);
+   de+=b.derivative[j]*(row[8*j+v]-center);
+  }
+  P[v][0]=double(value);P[v][1]=double(2*lambda/(den*den)*dt);
+  P[v][2]=double(T/(kap*(1-T*T*eta*eta))*de);
+ }
+}
+#endif
 // Return P, P_t, P_eta for one orthonormal Fourier mode.
 void evaluate_mode(const HiSpID_Data&s,int k,double t,double eta,double P[4][3]){
+#if HISPID_BARYCENTRIC_SAMPLER
+ if(s.seed_family==HISPID_SEED_TRUMPET_R0_M){evaluate_nodal_mode(s,k,t,eta,P);return;}
+#endif
  const int na=s.local.n[0],nb=s.local.n[1];std::vector<double>Ta,Da,Tb,Db;
  const double lambda=hispid::AxisDerivatives::radial_stretch,den=lambda+(1-lambda)*t,sigma=t/den,kappa=hispid::AxisDerivatives::angular_stretch,T=std::tanh(kappa),zeta=std::atanh(eta*T)/kappa;
  polynomial_basis(na,2*sigma-1,Ta,Da);polynomial_basis(nb,zeta,Tb,Db);std::memset(P,0,12*sizeof(double));
