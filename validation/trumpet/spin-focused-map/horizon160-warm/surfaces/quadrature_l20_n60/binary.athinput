# Initial-time import/finder control; override filename and source SHA on CLI.
<job>
basename = hispid
<mesh>
nghost = 4
nx1 = 16
nx2 = 16
nx3 = 16
x1min = -2
x1max = 2
x2min = -2
x2max = 2
x3min = -2
x3max = 2
ix1_bc = outflow
ox1_bc = outflow
ix2_bc = outflow
ox2_bc = outflow
ix3_bc = outflow
ox3_bc = outflow
<meshblock>
nx1 = 16
nx2 = 16
nx3 = 16
<time>
evolution = dynamic
integrator = rk4
cfl_number = 0.4
nlim = 0
tlim = 0
<z4c>
nco = 0
chi_div_floor = 1e-12
diss = 0.1
damp_kappa1 = 0.02
damp_kappa2 = 0
<mesh_refinement>
refinement = none
<fastflow>
factorized_harmonics = false
full_precision_trace = false
npunct = 0
num_horizons = 1
use_puncture_0 = -1
initial_radius_0 = 0.5
ntheta = 16
lmax = 8
flow_iterations_0 = 600
flow_alpha_beta_const_0 = 1
hmean_tol_0 = 100
mass_tol_0 = 1e-12
expansion_rms_tol_0 = 1e-7
start_time_0 = 0
stop_time_0 = 0
verbose = true
output_grid = false
output_ylm = false
use_puncture_massweighted_center_0 = false
center_x_0 = 0.0
center_y_0 = 0.0
center_z_0 = 0.0
use_puncture_1 = -1
start_time_1 = 0
stop_time_1 = 0
flow_iterations_1 = 600
flow_alpha_beta_const_1 = 0.2
expansion_rms_tol_1 = 1e-7
mass_tol_1 = 1e-12
hmean_tol_1 = 100
use_puncture_massweighted_center_1 = false
<problem>
hispid_horizon_shape_guess_0 = /pscratch/sd/h/hzhu/codex-hispid-trumpet-20261005/spin-focused-map/horizon160-warm/surfaces/spectral_l20_n40/hispid.horizon_shape_0.txt
hispid_horizon_shape_guess_1 = /pscratch/sd/h/hzhu/codex-hispid-trumpet-20261005/spin-focused-map/horizon160-warm/surfaces/spectral_l20_n40/hispid.horizon_shape_1.txt
hispid_parallel_geometry = true
hispid_filename = REPLACE_WITH_ABSOLUTE_CHECKPOINT
hispid_source_sha256 = REPLACE_WITH_SOURCE_SHA256
hispid_initial_horizons = true
hispid_common_horizon = false
hispid_direct_horizon_geometry = true
hispid_seed_horizon_guess = true
hispid_horizon_guess_scale = 1.05
hispid_flat_control = false
hispid_allow_diagnostic = false
hispid_allow_library_migration = false
hispid_preserve_horizon_centers = false
hispid_mesh_constraints = false
hispid_mesh_constraint_min_radius = 0.75
